{
  "$defs": {
    "FeaturePriority": {
      "description": "Priority bucket used for feature ordering.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "FeaturePriority",
      "type": "string"
    },
    "FeatureStatus": {
      "description": "Lifecycle status for a feature spec.",
      "enum": [
        "backlog",
        "in_progress",
        "done",
        "blocked"
      ],
      "title": "FeatureStatus",
      "type": "string"
    },
    "FeatureType": {
      "description": "Category of work captured by a feature spec.",
      "enum": [
        "feature",
        "bug",
        "spec",
        "docs",
        "chore",
        "test"
      ],
      "title": "FeatureType",
      "type": "string"
    },
    "SubtaskSpec": {
      "additionalProperties": false,
      "description": "Schema for a single subtask within a feature spec.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^ST-[0-9]{3,}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FeatureStatus"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "constraints": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints"
        },
        "verification": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification",
          "type": "array"
        },
        "attempts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempts"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "notes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "verification"
      ],
      "title": "SubtaskSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top-level schema for docs/spec/features/*.yaml.",
  "properties": {
    "id": {
      "minLength": 1,
      "pattern": "^FEAT-[0-9]{3,}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/FeatureType"
    },
    "expected_commit_subject": {
      "pattern": "^(feat|fix|spec|docs|chore|test): [^\\n]+$",
      "title": "Expected Commit Subject",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FeatureStatus"
    },
    "priority": {
      "$ref": "#/$defs/FeaturePriority"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context"
    },
    "constraints": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Constraints"
    },
    "implementation_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implementation Notes"
    },
    "acceptance": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Acceptance",
      "type": "array"
    },
    "subtasks": {
      "items": {
        "$ref": "#/$defs/SubtaskSpec"
      },
      "title": "Subtasks",
      "type": "array"
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "expected_commit_subject",
    "status",
    "priority",
    "objective",
    "acceptance"
  ],
  "title": "Agent Harness Feature",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
